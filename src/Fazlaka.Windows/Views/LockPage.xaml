<Page
    x:Class="Fazlaka.Windows.Views.LockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fazlaka.Windows.Views">

    <Page.Resources>
        <LinearGradientBrush x:Key="LockBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF0B0F19" />
            <GradientStop Offset="1" Color="#FF151B2B" />
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Background="{StaticResource LockBackdrop}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" MaxWidth="360">
            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource FazlakaGradient}" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8D7;" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="فذلكة" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" />
            <TextBlock Text="أدخل الرمز السري لفتح التطبيق" FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />

            <TextBlock Text="{x:Bind ErrorMessage}" FontSize="12" Foreground="{StaticResource FazlakaError}" HorizontalAlignment="Center" Visibility="{x:Bind helpers:Ui.ErrorStatusVisibility(HasError, ErrorMessage)}" />

            <PasswordBox x:Name="PinBox" PlaceholderText="الرمز السري" HorizontalAlignment="Center" Width="240" CornerRadius="12" KeyDown="OnPinKeyDown" />

            <Button Style="{StaticResource FazlakaGradientButtonStyle}" MinWidth="160" HorizontalAlignment="Center" Click="OnUnlockClicked">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7C3AED" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6D28D9" />
                </Button.Resources>
                <TextBlock Text="فتح" />
            </Button>
        </StackPanel>
    </Grid>
</Page>
