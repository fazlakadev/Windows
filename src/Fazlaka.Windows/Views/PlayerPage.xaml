<Page
    x:Class="Fazlaka.Windows.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F00B0F19" />
            <GradientStop Offset="1" Color="#D8151B2B" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#8B5CF6" />
            <GradientStop Offset="0.55" Color="#6D28D9" />
            <GradientStop Offset="1" Color="#312E81" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SheenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#26FFFFFF" />
            <GradientStop Offset="0.5" Color="#00FFFFFF" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="PurpleGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#738B5CF6" />
            <GradientStop Offset="1" Color="#008B5CF6" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="CyanGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#3D22D3EE" />
            <GradientStop Offset="1" Color="#0022D3EE" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="ChipBg" Color="#268B5CF6" />
        <SolidColorBrush x:Key="ChipFg" Color="#CDB9FF" />

        <Style x:Key="CircleGhostButton" TargetType="Button" BasedOn="{StaticResource FazlakaTransparentButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}" KeyDown="OnPageKeyDown">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="30" />
            </TransitionCollection>
        </Grid.Transitions>

        <Ellipse Width="700" Height="700" Fill="{StaticResource PurpleGlow}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-220,40,0,-60" IsHitTestVisible="False" />
        <Ellipse Width="520" Height="520" Fill="{StaticResource CyanGlow}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-180" IsHitTestVisible="False" />

        <Button
            Width="38" Height="38"
            Padding="0"
            CornerRadius="19"
            Style="{StaticResource CircleGhostButton}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="20,14,0,0"
            Click="OnCloseClicked"
            ToolTipService.ToolTip="إغلاق المشغّل (Esc)"
            AutomationProperties.Name="إغلاق المشغل">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
            </Button.Resources>
            <FontIcon Glyph="&#xE8BB;" FontSize="13" />
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <Grid MaxWidth="1080" HorizontalAlignment="Center" Margin="48,36,48,44" ColumnSpacing="52" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="360" Height="360" VerticalAlignment="Center">
                    <Ellipse Width="420" Height="420" Fill="{StaticResource PurpleGlow}" Margin="-30" IsHitTestVisible="False" />
                    <Border
                        Width="330"
                        Height="330"
                        CornerRadius="28"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid>
                            <Rectangle Fill="{StaticResource CoverGradient}" />
                            <FontIcon Glyph="&#xE8D6;" FontSize="88" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image
                                Source="{x:Bind helpers:Ui.ImageFromUrl(Player.CurrentEpisode.CoverUrl)}"
                                Stretch="UniformToFill"
                                Visibility="{x:Bind helpers:Ui.StringToVisibility(Player.CurrentEpisode.CoverUrl)}" />
                            <Rectangle Fill="{StaticResource SheenBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <Ellipse Width="16" Height="16" Fill="{StaticResource FazlakaSecondary}" Stroke="#0B0F19" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,26,0" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="14" FlowDirection="RightToLeft">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="{StaticResource ChipBg}" CornerRadius="999" Padding="10,4" Visibility="{x:Bind helpers:Ui.StringToVisibility(Player.CurrentEpisode.SeasonTitle)}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D6;" FontSize="10" Foreground="{StaticResource ChipFg}" />
                                <TextBlock Text="{x:Bind Player.CurrentEpisode.SeasonTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ChipFg}" MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>
                        </Border>
                        <Border Background="#161F2F" CornerRadius="999" Padding="10,4" Visibility="{x:Bind helpers:Ui.StringToVisibility(Player.CurrentEpisode.PublishedDisplay)}">
                            <TextBlock Text="{x:Bind Player.CurrentEpisode.PublishedDisplay}" FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" />
                        </Border>
                        <Border Background="#161F2F" CornerRadius="999" Padding="10,4">
                            <TextBlock FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}">
                                <Run Text="{x:Bind helpers:Ui.FormatCount(Player.CurrentEpisode.ViewCount)}" /><Run Text=" مشاهدة" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind Player.CurrentEpisode.Title}"
                        FontFamily="Segoe UI Variable Display, Segoe UI"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{StaticResource FazlakaTextPrimary}"
                        MaxLines="3"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource CoverGradient}">
                            <TextBlock Text="ف" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <TextBlock Text="فذلكة — بودكاست" FontSize="12" Foreground="{StaticResource FazlakaTextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind Player.CurrentEpisode.Description}"
                        FontSize="12.5"
                        LineHeight="21"
                        Foreground="{StaticResource FazlakaTextSecondary}"
                        MaxLines="4"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:Ui.StringToVisibility(Player.CurrentEpisode.Description)}" />

                    <StackPanel Spacing="2" Margin="0,10,0,0">
                        <Slider
                            x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="{x:Bind Player.SliderMaximum}"
                            FlowDirection="LeftToRight"
                            IsThumbToolTipEnabled="False">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackValueForeground" Color="#8B5CF6" />
                                <SolidColorBrush x:Key="SliderTrackValueForegroundPointerOver" Color="#A78BFA" />
                                <SolidColorBrush x:Key="SliderTrackValueForegroundPressed" Color="#7C3AED" />
                                <SolidColorBrush x:Key="SliderTrackBackground" Color="#24FFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E5E7EB" />
                            </Slider.Resources>
                        </Slider>
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Player.PositionText}" FontSize="11.5" Foreground="{StaticResource FazlakaTextSecondary}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Player.DurationText}" FontSize="11.5" Foreground="{StaticResource FazlakaTextSecondary}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" Margin="0,12,0,0" FlowDirection="LeftToRight">
                        <Button
                            Width="46" Height="46"
                            Style="{StaticResource CircleGhostButton}"
                            CornerRadius="23"
                            Click="OnBack15Clicked"
                            ToolTipService.ToolTip="رجوع 15 ثانية"
                            AutomationProperties.Name="رجوع 15 ثانية">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE7A7;" FontSize="17" />
                        </Button>

                        <Button
                            Width="50" Height="50"
                            Style="{StaticResource CircleGhostButton}"
                            CornerRadius="25"
                            Command="{x:Bind Player.SkipPreviousCommand}"
                            ToolTipService.ToolTip="الحلقة السابقة"
                            AutomationProperties.Name="الحلقة السابقة">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE892;" FontSize="17">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>

                        <Button
                            Width="74" Height="74"
                            Padding="0"
                            CornerRadius="37"
                            Style="{StaticResource FazlakaGradientButtonStyle}"
                            Command="{x:Bind Player.PlayPauseCommand}"
                            ToolTipService.ToolTip="تشغيل / إيقاف مؤقت (مسافة)"
                            AutomationProperties.Name="تشغيل أو إيقاف مؤقت">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7C3AED" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6D28D9" />
                            </Button.Resources>
                            <Grid>
                                <FontIcon Glyph="&#xE768;" FontSize="26" Visibility="{x:Bind helpers:Ui.ToCollapsed(Player.IsPlaying)}" />
                                <FontIcon Glyph="&#xE769;" FontSize="26" Visibility="{x:Bind helpers:Ui.ToVisibility(Player.IsPlaying)}" />
                            </Grid>
                        </Button>

                        <Button
                            Width="50" Height="50"
                            Style="{StaticResource CircleGhostButton}"
                            CornerRadius="25"
                            Command="{x:Bind Player.SkipNextCommand}"
                            ToolTipService.ToolTip="الحلقة التالية"
                            AutomationProperties.Name="الحلقة التالية">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE892;" FontSize="17" />
                        </Button>

                        <Button
                            Width="46" Height="46"
                            Style="{StaticResource CircleGhostButton}"
                            CornerRadius="23"
                            Click="OnForward15Clicked"
                            ToolTipService.ToolTip="تقديم 15 ثانية"
                            AutomationProperties.Name="تقديم 15 ثانية">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE7A6;" FontSize="17" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="QueueLabel"
                        FontSize="11"
                        Foreground="{StaticResource FazlakaTextSecondary}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        Opacity="0.85" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
