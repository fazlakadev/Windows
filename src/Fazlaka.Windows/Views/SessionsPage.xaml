<Page
    x:Class="Fazlaka.Windows.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    xmlns:models="using:Fazlaka.Windows.Models"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F20B0F19" />
            <GradientStop Offset="1" Color="#C2151B2B" />
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.Transitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="36,24,36,12" MaxWidth="900" HorizontalAlignment="Center" Spacing="4" FlowDirection="RightToLeft">
            <TextBlock Text="الجلسات النشطة" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" />
            <TextBlock Text="إدارة جميع أجهزتك المسجلة." FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8" Margin="0,24,36,0">
            <Button Background="#14EF4444" Foreground="#F87171" BorderThickness="0" CornerRadius="10" Padding="16,10" FontSize="13" FontWeight="SemiBold" Command="{x:Bind Vm.RevokeAllCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    <TextBlock Text="إنهاء جميع الجلسات" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ProgressRing Grid.Row="1" Width="36" Height="36" IsActive="{x:Bind Vm.IsLoading}" Visibility="{x:Bind helpers:Ui.ToVisibility(Vm.IsLoading)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Text="{x:Bind Vm.ErrorMessage}" Foreground="{StaticResource FazlakaTextSecondary}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind helpers:Ui.ErrorStatusVisibility(Vm.HasError, Vm.ErrorMessage)}" />
        <TextBlock Grid.Row="1" Text="{x:Bind Vm.SuccessMessage}" Foreground="{StaticResource FazlakaSuccess}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind helpers:Ui.InfoStatusVisibility(Vm.HasSuccessMessage, Vm.SuccessMessage)}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="36,12,36,40" Spacing="6" FlowDirection="RightToLeft">
                <ItemsControl ItemsSource="{x:Bind Vm.Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Session">
                            <Border Background="#0DFFFFFF" CornerRadius="12" Padding="16,12" Margin="0,0,0,4">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="22" Foreground="{StaticResource FazlakaTextSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind UserAgent}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}">
                                            <Run Text="{x:Bind IpAddress}" /><Run Text=" • " /><Run Text="{x:Bind CreatedAt}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="#268B5CF6" CornerRadius="999" Padding="8,3" Visibility="{x:Bind helpers:Ui.ToVisibility(IsCurrent)}">
                                            <TextBlock Text="الحالية" FontSize="10" FontWeight="SemiBold" Foreground="#CDB9FF" />
                                        </Border>
                                        <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="#14EF4444" Foreground="#F87171" Click="OnRevokeClick">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
