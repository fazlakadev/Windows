<Page
    x:Class="Fazlaka.Windows.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:model="using:Fazlaka.Windows.Models"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Required">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F20B0F19" />
            <GradientStop Offset="1" Color="#C2151B2B" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#7C3AED" />
            <GradientStop Offset="1" Color="#312E81" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="PurpleGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#4A8B5CF6" />
            <GradientStop Offset="1" Color="#008B5CF6" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="ChipBg" Color="#268B5CF6" />
        <SolidColorBrush x:Key="ChipFg" Color="#CDB9FF" />

        <Style x:Key="RowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FazlakaCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource FazlakaBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <DataTemplate x:Key="EpisodeRowTemplate" x:DataType="model:Episode">
            <Border Style="{StaticResource RowCardStyle}" Tapped="OnRowTapped">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="58" Height="58" CornerRadius="12">
                        <Grid>
                            <Rectangle Fill="{StaticResource CoverGradient}" />
                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="#66E9E2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image
                                Source="{x:Bind helpers:Ui.ImageFromUrl(CoverUrl)}"
                                Stretch="UniformToFill"
                                Visibility="{x:Bind helpers:Ui.StringToVisibility(CoverUrl)}" />
                            <Border
                                Width="18" Height="18"
                                CornerRadius="9"
                                Background="#10B981"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,3,3,0"
                                Visibility="{x:Bind helpers:Ui.ToVisibility(IsPlayed)}">
                                <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" FlowDirection="RightToLeft">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FazlakaTextPrimary}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Description}"
                            FontSize="11.5"
                            Foreground="{StaticResource FazlakaTextSecondary}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="{StaticResource ChipBg}" CornerRadius="999" Padding="8,2">
                                <TextBlock Text="{x:Bind FormattedDuration}" FontSize="10.5" Foreground="{StaticResource ChipFg}" />
                            </Border>
                            <Border Background="#161F2F" CornerRadius="999" Padding="8,2" Visibility="{x:Bind helpers:Ui.StringToVisibility(SeasonTitle)}">
                                <TextBlock Text="{x:Bind SeasonTitle}" FontSize="10.5" Foreground="{StaticResource FazlakaTextSecondary}" MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </Border>
                            <Border Background="#161F2F" CornerRadius="999" Padding="8,2">
                                <TextBlock FontSize="10.5" Foreground="{StaticResource FazlakaTextSecondary}">
                                    <Run Text="{x:Bind helpers:Ui.FormatCount(ViewCount)}" /><Run Text=" مشاهدة" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Padding="0"
                        CornerRadius="20"
                        Style="{StaticResource FazlakaGradientButtonStyle}"
                        Click="OnPlayEpisodeClick"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="تشغيل"
                        AutomationProperties.Name="تشغيل الحلقة">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7C3AED" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6D28D9" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.Transitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <Grid MaxWidth="980" HorizontalAlignment="Center" Margin="36,24,36,40">
                <StackPanel Spacing="16">

                    <StackPanel FlowDirection="RightToLeft" Spacing="4">
                        <TextBlock Text="البحث" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" />
                        <TextBlock Text="ابحث في كل الحلقات والمواسم عن كلمة أو عنوان." FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" />
                    </StackPanel>

                    <Grid FlowDirection="RightToLeft">
                        <TextBox
                            x:Name="SearchBox"
                            Height="50"
                            CornerRadius="14"
                            Padding="46,12,46,12"
                            FontSize="14"
                            PlaceholderText="ابحث عن حلقة، موسم، أو كلمة مفتاحية…"
                            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="OnSearchKeyDown"
                            Background="#CC1F2937"
                            BorderBrush="#33FFFFFF"
                            Foreground="{StaticResource FazlakaTextPrimary}"
                            PlaceholderForeground="#6B7280">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E61F2937" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#D91F2937" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#668B5CF6" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#44FFFFFF" />
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6B7280" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6B7280" />
                                <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#668B5CF6" />
                            </TextBox.Resources>
                        </TextBox>
                        <FontIcon Glyph="&#xE721;" FontSize="17" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" IsHitTestVisible="False" />
                        <Button
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="16"
                            Style="{StaticResource FazlakaTransparentButtonStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Visibility="{x:Bind helpers:Ui.StringToVisibility(ViewModel.Query)}"
                            Command="{x:Bind ViewModel.ClearSearchCommand}"
                            ToolTipService.ToolTip="مسح البحث"
                            AutomationProperties.Name="مسح البحث">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE894;" FontSize="12" />
                        </Button>
                    </Grid>

                    <muxc:InfoBar
                        IsOpen="{x:Bind ViewModel.HasError}"
                        Severity="Error"
                        Message="{x:Bind ViewModel.ErrorMessage}"
                        IsClosable="False">
                        <muxc:InfoBar.ActionButton>
                            <Button Content="إعادة المحاولة" Style="{StaticResource FazlakaTransparentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>

                    <StackPanel Orientation="Horizontal" Spacing="10" FlowDirection="RightToLeft"
                                Visibility="{x:Bind helpers:Ui.ResultsHeaderVisibility(ViewModel.HasSearched, ViewModel.IsSearching, ViewModel.HasError)}">
                        <TextBlock Text="النتائج" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" VerticalAlignment="Center" />
                        <Rectangle Width="30" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource FazlakaPrimary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.Results}"
                        SelectionMode="None"
                        ItemTemplate="{StaticResource EpisodeRowTemplate}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Visibility="{x:Bind helpers:Ui.PromptVisibility(ViewModel.HasSearched, ViewModel.IsSearching)}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="10" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                <Ellipse Width="120" Height="120" Fill="{StaticResource PurpleGlow}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="ابحث عن حلقاتك المفضلة" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="اكتب في الحقل أعلاه وستظهر النتائج تلقائياً أثناء الكتابة." FontSize="12.5" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsSearching)}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <ProgressRing Width="42" Height="42" IsActive="True" />
                <TextBlock Text="جارٍ البحث…" FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsEmpty)}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="10" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE946;" FontSize="40" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="لا توجد نتائج مطابقة" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="جرّب كلمات مفتاحية مختلفة أو تحقق من الإملاء." FontSize="12.5" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
