<Page
    x:Class="Fazlaka.Windows.Views.ArticlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:model="using:Fazlaka.Windows.Models"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Required">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F20B0F19" />
            <GradientStop Offset="1" Color="#C2151B2B" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SkeletonFill" Color="#141B2B" />

        <DataTemplate x:Key="ArticleCardTemplate" x:DataType="model:Article">
            <Border
                Background="{StaticResource FazlakaCard}"
                BorderBrush="{StaticResource FazlakaBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="0"
                Margin="0,0,0,12">
                <Grid ColumnSpacing="16" Padding="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="150" Height="110" CornerRadius="12">
                        <Grid>
                            <Rectangle Fill="#1A5B21B6" />
                            <FontIcon Glyph="&#xE8A5;" FontSize="36" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image
                                Source="{x:Bind helpers:Ui.ImageFromUrl(CoverImage)}"
                                Stretch="UniformToFill"
                                Visibility="{x:Bind helpers:Ui.StringToVisibility(CoverImage)}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" FlowDirection="RightToLeft">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FazlakaTextPrimary}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Description}"
                            FontSize="13"
                            Foreground="{StaticResource FazlakaTextSecondary}"
                            MaxLines="3"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            LineHeight="20" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind PublishedDisplay}" FontSize="12" Foreground="{StaticResource FazlakaTextSecondary}" />
                            <Border
                                Background="{StaticResource FazlakaPrimary}"
                                CornerRadius="999"
                                Padding="8,2"
                                Visibility="{x:Bind helpers:Ui.StringToVisibility(SeasonTitle)}">
                                <TextBlock Text="{x:Bind SeasonTitle}" FontSize="10" Foreground="White" MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.Transitions>

        <muxc:RefreshContainer x:Name="Refresher" RefreshRequested="OnRefreshRequested">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="900" HorizontalAlignment="Center" Margin="36,24,36,40">
                    <StackPanel Spacing="20">
                        <StackPanel FlowDirection="RightToLeft" Spacing="4">
                            <TextBlock Text="المقالات" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" />
                            <TextBlock Text="اقرأ أحدث المقالات والمحتوى الكتابي من فذلكة." FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" />
                        </StackPanel>

                        <muxc:InfoBar
                            IsOpen="{x:Bind ViewModel.HasError}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.ErrorMessage}"
                            IsClosable="False">
                            <muxc:InfoBar.ActionButton>
                                <Button Content="إعادة المحاولة" Style="{StaticResource FazlakaTransparentButtonStyle}" Command="{x:Bind ViewModel.LoadDataCommand}" />
                            </muxc:InfoBar.ActionButton>
                        </muxc:InfoBar>

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.Articles}"
                            ItemTemplate="{StaticResource ArticleCardTemplate}" />

                        <!-- Loading skeleton -->
                        <StackPanel Spacing="12" Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsLoading)}">
                            <Border Height="138" CornerRadius="16" Background="{StaticResource SkeletonFill}" />
                            <Border Height="138" CornerRadius="16" Background="{StaticResource SkeletonFill}" />
                            <Border Height="138" CornerRadius="16" Background="{StaticResource SkeletonFill}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </muxc:RefreshContainer>

        <Grid
            Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsEmpty)}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <StackPanel Spacing="10" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="44" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="لا توجد مقالات" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="لم نتمكن من العثور على مقالات. جرّب التحديث لاحقاً." FontSize="12.5" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                <Button Style="{StaticResource FazlakaTransparentButtonStyle}" Command="{x:Bind ViewModel.LoadDataCommand}" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="تحديث القائمة" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
