<Page
    x:Class="Fazlaka.Windows.Views.LikesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    xmlns:models="using:Fazlaka.Windows.Models"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F20B0F19" />
            <GradientStop Offset="1" Color="#C2151B2B" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF" />
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.Transitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="36,24,36,12" MaxWidth="900" HorizontalAlignment="Center">
            <StackPanel FlowDirection="RightToLeft" Spacing="4">
                <TextBlock Text="المفضلة" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" />
                <TextBlock Text="الحلقات التي أضفتها إلى المفضلة." FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" />
            </StackPanel>
        </Grid>

        <ProgressRing Grid.Row="0" Width="36" Height="36" IsActive="{x:Bind Vm.IsLoading}" Visibility="{x:Bind helpers:Ui.ToVisibility(Vm.IsLoading)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Grid.Row="0" Text="{x:Bind Vm.ErrorMessage}" Foreground="{StaticResource FazlakaTextSecondary}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind helpers:Ui.ErrorStatusVisibility(Vm.HasError, Vm.ErrorMessage)}" />
        <TextBlock Grid.Row="1" Text="لا توجد حلقات في المفضلة بعد." FontSize="14" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind helpers:Ui.ToVisibility(Vm.IsEmpty)}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="36,12,36,40" Spacing="6">
                <ItemsControl ItemsSource="{x:Bind Vm.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:HistoryItem">
                            <Border Background="#0DFFFFFF" CornerRadius="12" Padding="14,10" Margin="0,0,0,4">
                                <Grid ColumnSpacing="14" Tapped="OnItemTapped" Tag="{x:Bind}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10">
                                        <Grid>
                                            <Rectangle Fill="#1A8B5CF6" />
                                            <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind helpers:Ui.ImageFromUrl(Content.CoverImage)}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" FlowDirection="RightToLeft">
                                        <TextBlock Text="{x:Bind Content.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Content.SeasonTitle}" FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource FazlakaTransparentButtonStyle}" Click="OnItemPlayClicked" Tag="{x:Bind}" VerticalAlignment="Center">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                                        </Button.Resources>
                                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource FazlakaTextPrimary}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
