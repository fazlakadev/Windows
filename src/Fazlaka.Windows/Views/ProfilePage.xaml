<Page
    x:Class="Fazlaka.Windows.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Required">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F20B0F19" />
            <GradientStop Offset="1" Color="#C2151B2B" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="PurpleGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#598B5CF6" />
            <GradientStop Offset="1" Color="#008B5CF6" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#A78BFA" />
            <GradientStop Offset="0.55" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#5B21B6" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ChipBg" Color="#268B5CF6" />
        <SolidColorBrush x:Key="ChipFg" Color="#CDB9FF" />
        <SolidColorBrush x:Key="GoldChipBg" Color="#29F59E0B" />
        <SolidColorBrush x:Key="GoldChipFg" Color="#FCD34D" />
        <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF" />

        <Style x:Key="SettingsRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.Transitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <Grid MaxWidth="760" HorizontalAlignment="Center" Margin="36,24,36,40">
                <StackPanel Spacing="16">

                    <StackPanel FlowDirection="RightToLeft" Spacing="4">
                        <TextBlock Text="الملف الشخصي" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" />
                        <TextBlock Text="إدارة حسابك، التحديثات، والإعدادات." FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" />
                    </StackPanel>

                    <Border Style="{StaticResource FazlakaCardStyle}" Padding="20">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="96" Height="96">
                                <Ellipse Width="94" Height="94" Fill="{StaticResource PurpleGlow}" Margin="-4" />
                                <Border Width="82" Height="82" CornerRadius="41" Background="{StaticResource LogoGradient}" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Initials}"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind helpers:Ui.InitialsVisibility(ViewModel.AvatarUrl)}" />
                                        <Image
                                            Source="{x:Bind helpers:Ui.ImageFromUrl(ViewModel.AvatarUrl)}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind helpers:Ui.AvatarVisibility(ViewModel.AvatarUrl)}" />
                                    </Grid>
                                </Border>
                                <Ellipse Width="12" Height="12" Fill="{StaticResource FazlakaSuccess}" Stroke="#0B0F19" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" FlowDirection="RightToLeft">
                                <TextBlock Text="{x:Bind ViewModel.UserName}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.UserEmail}" FontSize="12.5" Foreground="{StaticResource FazlakaTextSecondary}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Border Background="{StaticResource GoldChipBg}" CornerRadius="999" Padding="10,3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{StaticResource GoldChipFg}" />
                                            <TextBlock Text="عضو فذلكة" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldChipFg}" />
                                        </StackPanel>
                                    </Border>
                                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading}" Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsLoading)}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10" FlowDirection="RightToLeft">
                        <Button
                            Style="{StaticResource FazlakaGradientButtonStyle}"
                            Command="{x:Bind ViewModel.CheckForUpdateCommand}"
                            IsEnabled="{x:Bind helpers:Ui.ToEnabled(ViewModel.IsCheckingForUpdate)}"
                            MinWidth="190"
                            ToolTipService.ToolTip="البحث عن إصدار جديد من التطبيق">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7C3AED" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6D28D9" />
                            </Button.Resources>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="9" Visibility="{x:Bind helpers:Ui.ToCollapsed(ViewModel.IsCheckingForUpdate)}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="التحقق من التحديثات" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="9" Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsCheckingForUpdate)}">
                                    <ProgressRing Width="16" Height="16" IsActive="True" />
                                    <TextBlock Text="جارٍ التحقق…" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            Background="#14EF4444"
                            Foreground="#F87171"
                            BorderThickness="0"
                            CornerRadius="10"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Command="{x:Bind ViewModel.LogoutCommand}"
                            ToolTipService.ToolTip="تسجيل الخروج من الحساب"
                            AutomationProperties.Name="تسجيل الخروج">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22EF4444" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#30EF4444" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FCA5A5" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FECACA" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                                <TextBlock Text="تسجيل الخروج" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind ViewModel.StatusMessage}"
                        FontSize="12.5"
                        Foreground="{StaticResource FazlakaSuccess}"
                        FlowDirection="RightToLeft"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:Ui.InfoStatusVisibility(ViewModel.HasError, ViewModel.StatusMessage)}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusMessage}"
                        FontSize="12.5"
                        Foreground="{StaticResource FazlakaError}"
                        FlowDirection="RightToLeft"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:Ui.ErrorStatusVisibility(ViewModel.HasError, ViewModel.StatusMessage)}" />

                    <Border
                        Background="#1AF59E0B"
                        BorderBrush="#33F59E0B"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.HasUpdate)}">
                        <Grid ColumnSpacing="14" FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#33F59E0B" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{StaticResource GoldChipFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="تحديث جديد متاح" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource FazlakaTextSecondary}">
                                    <Run Text="الإصدار " /><Run Text="{x:Bind ViewModel.PendingUpdate.Version}" /><Run Text=" جاهز للتثبيت." />
                                </TextBlock>
                                <TextBlock
                                    Text="{x:Bind ViewModel.PendingUpdate.ReleaseNotes}"
                                    FontSize="11.5"
                                    Foreground="{StaticResource FazlakaTextSecondary}"
                                    MaxLines="3"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind helpers:Ui.StringToVisibility(ViewModel.PendingUpdate.ReleaseNotes)}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Style="{StaticResource FazlakaGradientButtonStyle}"
                                Background="{StaticResource FazlakaSecondary}"
                                Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                IsEnabled="{x:Bind helpers:Ui.ToEnabledWhen(ViewModel.PendingUpdate, ViewModel.IsInstallingUpdate)}"
                                VerticalAlignment="Center">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FBBF24" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D97706" />
                                </Button.Resources>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind helpers:Ui.ToCollapsed(ViewModel.IsInstallingUpdate)}">
                                        <FontIcon Glyph="&#xE896;" FontSize="13" />
                                        <TextBlock Text="تثبيت التحديث" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsInstallingUpdate)}">
                                        <ProgressRing Width="15" Height="15" IsActive="True" />
                                        <TextBlock Text="جارٍ التنزيل…" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FazlakaCardStyle}" Padding="20,10">
                        <StackPanel FlowDirection="RightToLeft">
                            <TextBlock Text="الإعدادات" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" Margin="0,10,0,6" />

                            <Grid ColumnSpacing="12" Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{StaticResource FazlakaTextSecondary}" />
                                    <TextBlock Text="قناة التحديث" FontSize="13" Foreground="{StaticResource FazlakaTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource ChipBg}" CornerRadius="999" Padding="10,3">
                                    <TextBlock Text="{x:Bind Channel}" FontSize="11.5" Foreground="{StaticResource ChipFg}" />
                                </Border>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource Hairline}" />

                            <Grid ColumnSpacing="12" Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{StaticResource FazlakaTextSecondary}" />
                                    <TextBlock Text="إصدار التطبيق" FontSize="13" Foreground="{StaticResource FazlakaTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#161F2F" CornerRadius="999" Padding="10,3">
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource FazlakaTextSecondary}">
                                        <Run Text="v" /><Run Text="{x:Bind ViewModel.AppVersion}" />
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource Hairline}" />

                            <Grid ColumnSpacing="12" Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="{StaticResource FazlakaTextSecondary}" />
                                    <TextBlock Text="المظهر" FontSize="13" Foreground="{StaticResource FazlakaTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#161F2F" CornerRadius="999" Padding="10,3">
                                    <TextBlock Text="داكن" FontSize="11.5" Foreground="{StaticResource FazlakaTextSecondary}" />
                                </Border>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource Hairline}" />

                            <Grid ColumnSpacing="12" Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8C1;" FontSize="15" Foreground="{StaticResource FazlakaTextSecondary}" />
                                    <TextBlock Text="اللغة" FontSize="13" Foreground="{StaticResource FazlakaTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#161F2F" CornerRadius="999" Padding="10,3">
                                    <TextBlock Text="العربية" FontSize="11.5" Foreground="{StaticResource FazlakaTextSecondary}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0" FlowDirection="RightToLeft">
                        <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource LogoGradient}">
                            <TextBlock Text="ف" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <TextBlock Text="فذلكة © 2026 — جميع الحقوق محفوظة" FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" VerticalAlignment="Center" Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
