<Page
    x:Class="Fazlaka.Windows.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#E90B0F19" />
            <GradientStop Offset="1" Color="#D2151B2B" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="PurpleGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#668B5CF6" />
            <GradientStop Offset="1" Color="#008B5CF6" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GoldGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#4DF59E0B" />
            <GradientStop Offset="1" Color="#00F59E0B" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#A78BFA" />
            <GradientStop Offset="0.55" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#5B21B6" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GlassCard" Color="#B31C2333" />
        <SolidColorBrush x:Key="FieldBg" Color="#111827" />
        <SolidColorBrush x:Key="FieldBorder" Color="#374151" />
        <SolidColorBrush x:Key="FieldBorderFocus" Color="#8B5CF6" />
        <Storyboard x:Key="EntranceStory">
            <DoubleAnimation Storyboard.TargetName="CardHost" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="CardHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="28" To="0" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Ellipse Width="560" Height="560" Fill="{StaticResource PurpleGlow}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-200,0,0" IsHitTestVisible="False" />
        <Ellipse Width="480" Height="480" Fill="{StaticResource GoldGlow}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-170" IsHitTestVisible="False" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="CardHost"
                MaxWidth="480"
                Margin="24,16"
                VerticalAlignment="Center"
                FlowDirection="RightToLeft">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <!-- Logo -->
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <Ellipse Width="112" Height="112" Fill="{StaticResource PurpleGlow}" />
                    <Border Width="92" Height="92" CornerRadius="28" Background="{StaticResource LogoGradient}" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <Image x:Name="LogoImage" Stretch="UniformToFill" Width="80" Height="80" />
                    </Border>
                    <Ellipse Width="14" Height="14" Fill="{StaticResource FazlakaSecondary}" Stroke="#0B0F19" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" />
                </Grid>

                <TextBlock Text="فذلكة" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="36" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="منصّة الحلقات الصوتية العربية" FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />

                <!-- Card -->
                <Border Background="{StaticResource GlassCard}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="20" Padding="28,24" Margin="0,24,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="CardTitle" Text="مرحباً بعودتك" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" />
                        <TextBlock x:Name="CardSubtitle" Text="سجّل الدخول لمتابعة استماعك واكتشف حلقات جديدة." FontSize="12.5" Foreground="{StaticResource FazlakaTextSecondary}" LineHeight="21" TextWrapping="Wrap" />

                        <!-- Email field -->
                        <StackPanel x:Name="EmailGroup" Spacing="4">
                            <TextBlock Text="البريد الإلكتروني" FontSize="12" Foreground="{StaticResource FazlakaTextSecondary}" />
                            <Border Background="{StaticResource FieldBg}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="10" Padding="0">
                                <Grid>
                                    <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="#6B7280" Margin="14,0,0,0" HorizontalAlignment="Left" />
                                    <TextBox x:Name="EmailBox" PlaceholderText="example@email.com" FontSize="14" Padding="36,12,14,12"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource FazlakaTextPrimary}"
                                             PlaceholderForeground="#6B7280" FlowDirection="LeftToRight" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Password field -->
                        <StackPanel x:Name="PasswordGroup" Spacing="4">
                            <TextBlock Text="كلمة المرور" FontSize="12" Foreground="{StaticResource FazlakaTextSecondary}" />
                            <Border Background="{StaticResource FieldBg}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="10" Padding="0">
                                <Grid>
                                    <FontIcon Glyph="&#xE8D7;" FontSize="15" Foreground="#6B7280" Margin="14,0,0,0" HorizontalAlignment="Left" />
                                    <PasswordBox x:Name="PasswordBox" PlaceholderText="••••••••" FontSize="14" Padding="36,12,14,12"
                                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource FazlakaTextPrimary}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Username field (register only) -->
                        <StackPanel x:Name="UsernameGroup" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="اسم المستخدم" FontSize="12" Foreground="{StaticResource FazlakaTextSecondary}" />
                            <Border Background="{StaticResource FieldBg}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="10" Padding="0">
                                <Grid>
                                    <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="#6B7280" Margin="14,0,0,0" HorizontalAlignment="Left" />
                                    <TextBox x:Name="UsernameBox" PlaceholderText="username" FontSize="14" Padding="36,12,14,12"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource FazlakaTextPrimary}"
                                             PlaceholderForeground="#6B7280" FlowDirection="LeftToRight" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Name field (register only) -->
                        <StackPanel x:Name="NameGroup" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="الاسم الكامل" FontSize="12" Foreground="{StaticResource FazlakaTextSecondary}" />
                            <Border Background="{StaticResource FieldBg}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="10" Padding="0">
                                <Grid>
                                    <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="#6B7280" Margin="14,0,0,0" HorizontalAlignment="Left" />
                                    <TextBox x:Name="NameBox" PlaceholderText="Mohamed Ali" FontSize="14" Padding="36,12,14,12"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource FazlakaTextPrimary}"
                                             PlaceholderForeground="#6B7280" FlowDirection="LeftToRight" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Login / Register button -->
                        <Button x:Name="SubmitButton"
                                Height="52"
                                CornerRadius="12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{StaticResource FazlakaGradient}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Click="OnSubmitClicked">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7C3AED" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6D28D9" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#374151" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B7280" />
                            </Button.Resources>
                            <TextBlock x:Name="SubmitText" Text="تسجيل الدخول" />
                        </Button>

                        <!-- Divider -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="#374151" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="أو" FontSize="12" Foreground="#6B7280" Margin="12,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="#374151" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Google button -->
                        <Button
                            x:Name="GoogleButton"
                            Height="48"
                            CornerRadius="12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#FFFFFF"
                            Foreground="#1F2937"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Click="OnGoogleClicked">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F3F4F6" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E5E7EB" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E9EAEE" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111827" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111827" />
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#9CA3AF" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Path Data="M17.64 9.2045c0-.6381-.0573-1.2518-.1636-1.8409H9v3.4814h4.8436c-.2086 1.125-.8427 2.0782-1.7959 2.7164v2.2581h2.9087c1.7018-1.5668 2.6836-3.874 2.6836-6.615z" Fill="#4285F4" />
                                    <Path Data="M9 18c2.43 0 4.4673-.8059 5.9564-2.1805l-2.9087-2.2581c-.8059.54-1.8368.859-3.0477.859-2.344 0-4.3282-1.5831-5.036-3.7104H.9574v2.3318C2.4382 15.9832 5.4818 18 9 18z" Fill="#34A853" />
                                    <Path Data="M3.964 10.71c-.18-.54-.2822-1.1168-.2822-1.71s.1023-1.17.2823-1.71V4.9582H.9573C.3477 6.1732 0 7.5477 0 9s.3477 2.8268.9573 4.0418L3.964 10.71z" Fill="#FBBC05" />
                                    <Path Data="M9 3.5795c1.3214 0 2.5077.4541 3.4405 1.346l2.5813-2.5814C13.4632.8918 11.426 0 9 0 5.4818 0 2.4382 2.0168.9573 4.9582L3.964 7.29C4.6718 5.1627 6.656 3.5795 9 3.5795z" Fill="#EA4335" />
                                </Grid>
                                <TextBlock Text="المتابعة بـ Google" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- GitHub button -->
                        <Button
                            x:Name="GithubButton"
                            Height="48"
                            CornerRadius="12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#24292E"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Click="OnGithubClicked">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2F363D" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1C2128" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#374151" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B7280" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" Fill="White" />
                                <TextBlock Text="المتابعة بـ GitHub" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Facebook button -->
                        <Button
                            x:Name="FacebookButton"
                            Height="48"
                            CornerRadius="12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#1877F2"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Click="OnFacebookClicked">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#166FE5" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1565C0" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#374151" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B7280" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Path Data="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" Fill="White" />
                                <TextBlock Text="المتابعة بـ Facebook" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Busy -->
                        <StackPanel x:Name="BusyPanel" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <ProgressRing x:Name="SignInRing" Width="26" Height="26" IsActive="True" />
                            <TextBlock x:Name="BusyText" Text="جارٍ تسجيل الدخول…" FontSize="11.5" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Error -->
                        <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#FCA5A5" VerticalAlignment="Top" />
                                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FECACA" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Toggle login/register -->
                <TextBlock x:Name="ToggleLabel" Text="ليس لديك حساب؟  أنشئ حساباً" FontSize="12.5" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" Margin="0,16,0,0" IsTapEnabled="True" Tapped="OnToggleTapped" />
                <TextBlock Text="بالمتابعة أنت توافق على شروط الاستخدام وسياسة الخصوصية." FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.85" />
                <TextBlock Text="{x:Bind VersionDisplay}" FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.65" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
