<Page
    x:Class="Fazlaka.Windows.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#E90B0F19" />
            <GradientStop Offset="1" Color="#D2151B2B" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="PurpleGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#668B5CF6" />
            <GradientStop Offset="1" Color="#008B5CF6" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GoldGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#4DF59E0B" />
            <GradientStop Offset="1" Color="#00F59E0B" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#A78BFA" />
            <GradientStop Offset="0.55" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#5B21B6" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GlassCard" Color="#B31C2333" />
        <Storyboard x:Key="EntranceStory">
            <DoubleAnimation
                Storyboard.TargetName="CardHost"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.45" />
            <DoubleAnimation
                Storyboard.TargetName="CardHost"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="28" To="0"
                Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Ellipse Width="560" Height="560" Fill="{StaticResource PurpleGlow}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-200,0,0" IsHitTestVisible="False" />
        <Ellipse Width="480" Height="480" Fill="{StaticResource GoldGlow}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-170" IsHitTestVisible="False" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="CardHost"
                MaxWidth="460"
                Margin="24,16"
                VerticalAlignment="Center"
                FlowDirection="RightToLeft">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <Grid Width="140" Height="140" HorizontalAlignment="Center">
                    <Ellipse Width="132" Height="132" Fill="{StaticResource PurpleGlow}" />
                    <Border Width="92" Height="92" CornerRadius="30" Background="{StaticResource LogoGradient}" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <TextBlock Text="ف" FontSize="46" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0" />
                    </Border>
                    <Ellipse Width="14" Height="14" Fill="{StaticResource FazlakaSecondary}" Stroke="#0B0F19" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,20" />
                </Grid>

                <TextBlock Text="فذلكة" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="38" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="منصّة الحلقات الصوتية العربية" FontSize="13.5" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />

                <Border
                    Background="{StaticResource GlassCard}"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="28,26"
                    Margin="0,28,0,0">
                    <StackPanel Spacing="14">
                        <TextBlock Text="مرحباً بعودتك" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" />
                        <TextBlock Text="سجّل الدخول لمتابعة استماعك، واكتشف حلقات جديدة، وزامن تقدّمك عبر أجهزتك." FontSize="12.5" Foreground="{StaticResource FazlakaTextSecondary}" LineHeight="21" TextWrapping="Wrap" />

                        <Button
                            x:Name="GoogleButton"
                            Height="50"
                            CornerRadius="12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#FFFFFF"
                            Foreground="#1F2937"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="OnSignInClicked">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F3F4F6" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E5E7EB" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E9EAEE" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111827" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111827" />
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#9CA3AF" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Path Data="M17.64 9.2045c0-.6381-.0573-1.2518-.1636-1.8409H9v3.4814h4.8436c-.2086 1.125-.8427 2.0782-1.7959 2.7164v2.2581h2.9087c1.7018-1.5668 2.6836-3.874 2.6836-6.615z" Fill="#4285F4" />
                                    <Path Data="M9 18c2.43 0 4.4673-.8059 5.9564-2.1805l-2.9087-2.2581c-.8059.54-1.8368.859-3.0477.859-2.344 0-4.3282-1.5831-5.036-3.7104H.9574v2.3318C2.4382 15.9832 5.4818 18 9 18z" Fill="#34A853" />
                                    <Path Data="M3.964 10.71c-.18-.54-.2822-1.1168-.2822-1.71s.1023-1.17.2823-1.71V4.9582H.9573C.3477 6.1732 0 7.5477 0 9s.3477 2.8268.9573 4.0418L3.964 10.71z" Fill="#FBBC05" />
                                    <Path Data="M9 3.5795c1.3214 0 2.5077.4541 3.4405 1.346l2.5813-2.5814C13.4632.8918 11.426 0 9 0 5.4818 0 2.4382 2.0168.9573 4.9582L3.964 7.29C4.6718 5.1627 6.656 3.5795 9 3.5795z" Fill="#EA4335" />
                                </Grid>
                                <TextBlock Text="المتابعة باستخدام Google" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel x:Name="BusyPanel" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <ProgressRing x:Name="SignInRing" Width="26" Height="26" IsActive="True" />
                            <TextBlock Text="بانتظار اكتمال تسجيل الدخول في المتصفح…" FontSize="11.5" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border
                            x:Name="ErrorPanel"
                            Visibility="Collapsed"
                            Background="#1AEF4444"
                            BorderBrush="#33EF4444"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#FCA5A5" VerticalAlignment="Top" />
                                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FECACA" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="بالمتابعة أنت توافق على شروط الاستخدام وسياسة الخصوصية." FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0.85" />
                <TextBlock Text="{x:Bind VersionDisplay}" FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.65" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
