<Page
    x:Class="Fazlaka.Windows.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:model="using:Fazlaka.Windows.Models"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Required">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F20B0F19" />
            <GradientStop Offset="1" Color="#C2151B2B" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#7C3AED" />
            <GradientStop Offset="1" Color="#312E81" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="PurpleGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#558B5CF6" />
            <GradientStop Offset="1" Color="#008B5CF6" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="CyanGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#4D22D3EE" />
            <GradientStop Offset="1" Color="#0022D3EE" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GoldGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#4DF59E0B" />
            <GradientStop Offset="1" Color="#00F59E0B" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="HeroFade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F25B21B6" />
            <GradientStop Offset="0.55" Color="#005B21B6" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ChipBg" Color="#268B5CF6" />
        <SolidColorBrush x:Key="ChipFg" Color="#CDB9FF" />
        <SolidColorBrush x:Key="GoldChipBg" Color="#29F59E0B" />
        <SolidColorBrush x:Key="GoldChipFg" Color="#FCD34D" />
        <SolidColorBrush x:Key="GlassChipBg" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="SkeletonFill" Color="#141B2B" />

        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FazlakaCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource FazlakaBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource FazlakaTextPrimary}" />
        </Style>

        <Storyboard x:Key="Pulse">
            <DoubleAnimation
                Storyboard.TargetName="SkeletonRoot"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0.55"
                Duration="0:0:1.1"
                AutoReverse="True"
                RepeatBehavior="Forever" />
        </Storyboard>

        <DataTemplate x:Key="EpisodeCardTemplate" x:DataType="model:Episode">
            <Button Style="{StaticResource CardButtonStyle}" Click="OnPlayEpisodeClick" ToolTipService.ToolTip="{x:Bind Title}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#232A3B" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2A3245" />
                </Button.Resources>
                <StackPanel Margin="10" Spacing="10" Width="200">
                    <Grid Height="170" CornerRadius="10">
                        <Rectangle Fill="{StaticResource CoverGradient}" />
                        <FontIcon Glyph="&#xE8D6;" FontSize="46" Foreground="#30FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image
                            Source="{x:Bind helpers:Ui.ImageFromUrl(CoverImage)}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind helpers:Ui.StringToVisibility(CoverImage)}" />
                        <Border
                            Background="#CC0B0F19"
                            CornerRadius="999"
                            Padding="8,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="8">
                            <TextBlock Text="{x:Bind FormattedDuration}" FontSize="11" Foreground="White" />
                        </Border>
                        <Border
                            Width="34" Height="34"
                            CornerRadius="17"
                            Background="{StaticResource FazlakaGradient}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8">
                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border
                            Background="#AA7C3AED"
                            CornerRadius="999"
                            Padding="6,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White">
                                <Run Text="{x:Bind EpisodeNumber}" /><Run Text="#" />
                            </TextBlock>
                        </Border>
                    </Grid>
                    <TextBlock
                        Text="{x:Bind Title}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource FazlakaTextPrimary}"
                        MaxLines="2"
                        MinHeight="36"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        FlowDirection="RightToLeft" />
                    <TextBlock FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" MaxLines="1" TextTrimming="CharacterEllipsis" FlowDirection="RightToLeft">
                        <Run Text="{x:Bind SeasonTitle}" /><Run Text="  •  " /><Run Text="{x:Bind PublishedDisplay}" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SeasonCardTemplate" x:DataType="model:Season">
            <Button Style="{StaticResource CardButtonStyle}" Click="OnSeasonClick" ToolTipService.ToolTip="{x:Bind Title}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#232A3B" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2A3245" />
                </Button.Resources>
                <Grid Width="180" Height="110" CornerRadius="14">
                    <Rectangle Fill="{StaticResource CoverGradient}" />
                    <FontIcon Glyph="&#xE8EC;" FontSize="36" Foreground="#30FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image
                        Source="{x:Bind helpers:Ui.ImageFromUrl(CoverImage)}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind helpers:Ui.StringToVisibility(CoverImage)}" />
                    <Rectangle Fill="#7A0B0F19" />
                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12" Spacing="3" FlowDirection="RightToLeft">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="White"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind EpisodesDisplay}" FontSize="11" Foreground="#C8CBD5E1" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistCardTemplate" x:DataType="model:Playlist">
            <Button Style="{StaticResource CardButtonStyle}" ToolTipService.ToolTip="{x:Bind Title}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#232A3B" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2A3245" />
                </Button.Resources>
                <Grid Width="200" Height="120" CornerRadius="14">
                    <Rectangle Fill="#1A5B21B6" />
                    <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="#30FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image
                        Source="{x:Bind helpers:Ui.ImageFromUrl(CoverImage)}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind helpers:Ui.StringToVisibility(CoverImage)}" />
                    <Rectangle Fill="#8A0B0F19" />
                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12" Spacing="4" FlowDirection="RightToLeft">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="White"
                            MaxLines="2"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            MaxHeight="36" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ItemCountDisplay}" FontSize="11" Foreground="#C8CBD5E1" />
                            <Border
                                Background="#66FFFFFF"
                                CornerRadius="999"
                                Padding="6,1"
                                Visibility="{x:Bind helpers:Ui.ToVisibility(IsPlatform)}">
                                <TextBlock Text="منصّة" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.Transitions>

        <muxc:RefreshContainer x:Name="Refresher" RefreshRequested="OnRefreshRequested">
            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                <Grid MaxWidth="1180" HorizontalAlignment="Center" Margin="36,24,36,40">
                    <StackPanel Spacing="22">

                        <!-- Greeting -->
                        <StackPanel FlowDirection="RightToLeft" Spacing="4">
                            <TextBlock Text="مرحباً بك مجدداً في فذلكة" FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" />
                            <TextBlock Text="{x:Bind Greeting}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Featured Hero -->
                        <Button
                            Style="{StaticResource CardButtonStyle}"
                            CornerRadius="20"
                            Height="250"
                            Command="{x:Bind ViewModel.PlayFeaturedCommand}"
                            Visibility="{x:Bind helpers:Ui.ObjectToVisibility(ViewModel.FeaturedEpisode)}"
                            AutomationProperties.Name="تشغيل الحلقة المميزة">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2FFFFFFF" />
                            </Button.Resources>
                            <Grid x:Name="HeroRoot">
                                <Rectangle Fill="{StaticResource FazlakaGradient}" />
                                <Ellipse Width="460" Height="460" Fill="{StaticResource CyanGlow}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-140,0" IsHitTestVisible="False" />
                                <Ellipse Width="380" Height="380" Fill="{StaticResource GoldGlow}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-150" IsHitTestVisible="False" />

                                <Grid Width="320" HorizontalAlignment="Right" IsHitTestVisible="False">
                                    <Image
                                        Source="{x:Bind helpers:Ui.ImageFromUrl(ViewModel.FeaturedEpisode.CoverImage)}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind helpers:Ui.StringToVisibility(ViewModel.FeaturedEpisode.CoverImage)}" />
                                    <Rectangle Fill="{StaticResource HeroFade}" />
                                </Grid>

                                <StackPanel
                                    Margin="32,24"
                                    VerticalAlignment="Center"
                                    FlowDirection="RightToLeft"
                                    Spacing="10"
                                    MaxWidth="600"
                                    HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{StaticResource GlassChipBg}" CornerRadius="999" Padding="10,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{StaticResource GoldChipFg}" />
                                                <TextBlock Text="حلقة مميزة" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldChipFg}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource GlassChipBg}" CornerRadius="999" Padding="10,4" Visibility="{x:Bind helpers:Ui.StringToVisibility(ViewModel.FeaturedEpisode.SeasonTitle)}">
                                            <TextBlock Text="{x:Bind ViewModel.FeaturedEpisode.SeasonTitle}" FontSize="11" Foreground="#E2E8F0" MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind ViewModel.FeaturedEpisode.Title}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="Bold" Foreground="White" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{x:Bind ViewModel.FeaturedEpisode.Description}" FontSize="12.5" Foreground="#DDE3EECC" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="19" />

                                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBlock Text="{x:Bind ViewModel.FeaturedEpisode.FormattedDuration}" FontSize="12" Foreground="#CBD5E1" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7B3;" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBlock FontSize="12" Foreground="#CBD5E1">
                                                <Run Text="{x:Bind helpers:Ui.FormatCount(ViewModel.FeaturedEpisode.ViewsCount)}" /><Run Text=" مشاهدة" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="#FFFFFF" CornerRadius="999" Padding="16,9" HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="#4C1D95" />
                                            <TextBlock Text="استمع الآن" FontSize="13" FontWeight="SemiBold" Foreground="#4C1D95" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Latest Episodes Section -->
                        <StackPanel Visibility="{x:Bind helpers:Ui.ObjectToVisibility(ViewModel.LatestEpisodes)}">
                            <StackPanel Orientation="Horizontal" Spacing="12" FlowDirection="RightToLeft" Margin="2,8,2,0">
                                <TextBlock Text="أحدث الحلقات" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <Rectangle Width="34" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource FazlakaPrimary}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ScrollViewer
                                x:Name="LatestScroller"
                                HorizontalScrollMode="Enabled"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Disabled"
                                PointerWheelChanged="OnLatestWheelChanged">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LatestEpisodes}" ItemTemplate="{StaticResource EpisodeCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Seasons Section -->
                        <StackPanel Visibility="{x:Bind helpers:Ui.ObjectToVisibility(ViewModel.LatestSeasons)}">
                            <StackPanel Orientation="Horizontal" Spacing="12" FlowDirection="RightToLeft" Margin="2,12,2,0">
                                <TextBlock Text="المواسم" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <Rectangle Width="34" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource FazlakaSecondary}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ScrollViewer
                                x:Name="SeasonsScroller"
                                HorizontalScrollMode="Enabled"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Disabled"
                                PointerWheelChanged="OnSeasonsWheelChanged">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LatestSeasons}" ItemTemplate="{StaticResource SeasonCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Playlists Section -->
                        <StackPanel Visibility="{x:Bind helpers:Ui.ObjectToVisibility(ViewModel.LatestPlaylists)}">
                            <StackPanel Orientation="Horizontal" Spacing="12" FlowDirection="RightToLeft" Margin="2,12,2,0">
                                <TextBlock Text="قوائم التشغيل" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <Rectangle Width="34" Height="4" RadiusX="2" RadiusY="2" Fill="#F59E0B" VerticalAlignment="Center" />
                            </StackPanel>

                            <ScrollViewer
                                x:Name="PlaylistsScroller"
                                HorizontalScrollMode="Enabled"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Disabled"
                                PointerWheelChanged="OnPlaylistsWheelChanged">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LatestPlaylists}" ItemTemplate="{StaticResource PlaylistCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </muxc:RefreshContainer>

        <muxc:InfoBar
            IsOpen="{x:Bind ViewModel.HasError}"
            Severity="Error"
            Message="{x:Bind ViewModel.ErrorMessage}"
            IsClosable="False"
            Margin="24,18,24,0"
            VerticalAlignment="Top"
            MaxWidth="720"
            HorizontalAlignment="Center">
            <muxc:InfoBar.ActionButton>
                <Button Content="إعادة المحاولة" Style="{StaticResource FazlakaTransparentButtonStyle}" Command="{x:Bind ViewModel.LoadDataCommand}" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <Grid
            Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsEmpty)}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <StackPanel Spacing="10" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;" FontSize="44" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="لا توجد محتوى لعرضها الآن" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="لم نتمكن من العثور على أي محتوى. جرّب التحديث لاحقاً." FontSize="12.5" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                <Button Style="{StaticResource FazlakaTransparentButtonStyle}" Command="{x:Bind ViewModel.LoadDataCommand}" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="تحديث القائمة" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="SkeletonRoot"
            Background="#E60D1220"
            Visibility="Collapsed"
            IsHitTestVisible="False">
            <StackPanel MaxWidth="1180" HorizontalAlignment="Left" Margin="36,24,36,40" Spacing="20">
                <StackPanel Spacing="8">
                    <Rectangle Height="14" Width="180" Fill="{StaticResource SkeletonFill}" RadiusX="6" RadiusY="6" HorizontalAlignment="Left" />
                    <Rectangle Height="24" Width="260" Fill="{StaticResource SkeletonFill}" RadiusX="8" RadiusY="8" HorizontalAlignment="Left" />
                </StackPanel>
                <Border Height="250" CornerRadius="20" Background="{StaticResource SkeletonFill}" />
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="220" Height="280" CornerRadius="14" Background="{StaticResource SkeletonFill}" />
                    <Border Width="220" Height="280" CornerRadius="14" Background="{StaticResource SkeletonFill}" />
                    <Border Width="220" Height="280" CornerRadius="14" Background="{StaticResource SkeletonFill}" />
                    <Border Width="220" Height="280" CornerRadius="14" Background="{StaticResource SkeletonFill}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="194" Height="124" CornerRadius="14" Background="{StaticResource SkeletonFill}" />
                    <Border Width="194" Height="124" CornerRadius="14" Background="{StaticResource SkeletonFill}" />
                    <Border Width="194" Height="124" CornerRadius="14" Background="{StaticResource SkeletonFill}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
