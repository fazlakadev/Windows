<Page
    x:Class="Fazlaka.Windows.Views.SeasonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:model="using:Fazlaka.Windows.Models"
    xmlns:helpers="using:Fazlaka.Windows.Views"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Required">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackdrop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F20B0F19" />
            <GradientStop Offset="1" Color="#C2151B2B" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#7C3AED" />
            <GradientStop Offset="1" Color="#312E81" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="PurpleGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#4A8B5CF6" />
            <GradientStop Offset="1" Color="#008B5CF6" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="ChipBg" Color="#268B5CF6" />
        <SolidColorBrush x:Key="ChipFg" Color="#CDB9FF" />

        <Style x:Key="RowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FazlakaCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource FazlakaBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <DataTemplate x:Key="SeasonTemplate" x:DataType="model:Season">
            <Grid ColumnSpacing="12" Margin="4" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14">
                    <Grid>
                        <Rectangle Fill="{StaticResource CoverGradient}" />
                        <FontIcon Glyph="&#xE8EC;" FontSize="22" Foreground="#66E9E2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image
                            Source="{x:Bind helpers:Ui.ImageFromUrl(CoverImage)}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind helpers:Ui.StringToVisibility(CoverImage)}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        Text="{x:Bind Title}"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource FazlakaTextPrimary}"
                        MaxLines="2"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Foreground="{StaticResource FazlakaTextSecondary}" MaxLines="1" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind EpisodesDisplay}" /><Run Text="  •  " /><Run Text="{x:Bind PublishedDisplay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EpisodeRowTemplate" x:DataType="model:Episode">
            <Border Style="{StaticResource RowCardStyle}" Tapped="OnRowTapped">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="58" Height="58">
                        <Border Grid.Column="0" Width="58" Height="58" CornerRadius="12">
                            <Grid>
                                <Rectangle Fill="{StaticResource CoverGradient}" />
                                <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="#66E9E2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image
                                    Source="{x:Bind helpers:Ui.ImageFromUrl(CoverImage)}"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind helpers:Ui.StringToVisibility(CoverImage)}" />
                            </Grid>
                        </Border>
                        <Border
                            Width="20" Height="20"
                            CornerRadius="10"
                            Background="#AA7C3AED"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-4,-4,0"
                            Padding="0">
                            <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Run Text="{x:Bind EpisodeNumber}" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" FlowDirection="RightToLeft">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FazlakaTextPrimary}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Description}"
                            FontSize="11.5"
                            Foreground="{StaticResource FazlakaTextSecondary}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="{StaticResource ChipBg}" CornerRadius="999" Padding="8,2">
                                <TextBlock Text="{x:Bind FormattedDuration}" FontSize="10.5" Foreground="{StaticResource ChipFg}" />
                            </Border>
                            <Border Background="#161F2F" CornerRadius="999" Padding="8,2">
                                <TextBlock FontSize="10.5" Foreground="{StaticResource FazlakaTextSecondary}">
                                    <Run Text="{x:Bind helpers:Ui.FormatCount(ViewsCount)}" /><Run Text=" مشاهدة" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Padding="0"
                        CornerRadius="20"
                        Style="{StaticResource FazlakaGradientButtonStyle}"
                        Click="OnPlayEpisodeClick"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="تشغيل"
                        AutomationProperties.Name="تشغيل الحلقة">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#7C3AED" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6D28D9" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackdrop}">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.Transitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <Grid MaxWidth="1240" HorizontalAlignment="Center" Margin="36,24,36,40">
                <StackPanel Spacing="16">

                    <StackPanel FlowDirection="RightToLeft" Spacing="4">
                        <TextBlock Text="المواسم" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="{StaticResource FazlakaTextPrimary}" />
                        <TextBlock Text="تصفّح المواسم واختر موسماً لعرض حلقاته." FontSize="13" Foreground="{StaticResource FazlakaTextSecondary}" />
                    </StackPanel>

                    <muxc:InfoBar
                        IsOpen="{x:Bind ViewModel.HasError}"
                        Severity="Error"
                        Message="{x:Bind ViewModel.ErrorMessage}"
                        IsClosable="False">
                        <muxc:InfoBar.ActionButton>
                            <Button Content="إعادة المحاولة" Style="{StaticResource FazlakaTransparentButtonStyle}" Command="{x:Bind ViewModel.LoadSeasonsCommand}" />
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>

                    <Grid ColumnSpacing="20" MinHeight="480">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="{StaticResource FazlakaSurface}"
                            BorderBrush="{StaticResource FazlakaBorder}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Text="كل المواسم"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="40"
                                    Foreground="{StaticResource FazlakaTextSecondary}"
                                    Margin="10,6,10,8"
                                    FlowDirection="RightToLeft" />

                                <ListView
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.Seasons}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSeason, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSeasonSelectionChanged"
                                    ItemTemplate="{StaticResource SeasonTemplate}">
                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1A8B5CF6" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#228B5CF6" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2E8B5CF6" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#338B5CF6" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#3D8B5CF6" />
                                    </ListView.Resources>
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="CornerRadius" Value="12" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>

                                <Grid Grid.Row="1" Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.IsLoadingSeasons)}">
                                    <ProgressRing Width="36" Height="36" IsActive="True" />
                                </Grid>

                                <Grid Grid.Row="1" Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.HasNoSeasons)}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="30" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="لا توجد مواسم بعد" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" FlowDirection="RightToLeft" Margin="2,0,2,10">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedSeason.Title}"
                                    FontFamily="Segoe UI Variable Display, Segoe UI"
                                    FontSize="19"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource FazlakaTextPrimary}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="420"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind helpers:Ui.ObjectToVisibility(ViewModel.SelectedSeason)}" />
                                <Border Background="{StaticResource ChipBg}" CornerRadius="999" Padding="10,3" VerticalAlignment="Center" Visibility="{x:Bind helpers:Ui.ObjectToVisibility(ViewModel.SelectedSeason)}">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSeason.EpisodesDisplay}" FontSize="11" Foreground="{StaticResource ChipFg}" />
                                </Border>
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoadingEpisodes}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>

                            <Border
                                Grid.Row="1"
                                Background="{StaticResource FazlakaSurface}"
                                BorderBrush="{StaticResource FazlakaBorder}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                                        <ListView
                                            ItemsSource="{x:Bind ViewModel.Episodes}"
                                            SelectionMode="None"
                                            ItemTemplate="{StaticResource EpisodeRowTemplate}">
                                            <ListView.ItemContainerTransitions>
                                                <TransitionCollection>
                                                    <AddDeleteThemeTransition />
                                                </TransitionCollection>
                                            </ListView.ItemContainerTransitions>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,10" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                    </ScrollViewer>

                                    <Grid Visibility="{x:Bind helpers:Ui.ToVisibility(ViewModel.HasNoEpisodes)}">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                            <FontIcon Glyph="&#xE930;" FontSize="30" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="هذا الموسم لا يحتوي على حلقات" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Visibility="{x:Bind helpers:Ui.ToCollapsed(ViewModel.HasSelectedSeason)}">
                                        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                            <Ellipse Width="110" Height="110" Fill="{StaticResource PurpleGlow}" HorizontalAlignment="Center" />
                                            <FontIcon Glyph="&#xE8D6;" FontSize="34" Foreground="{StaticResource FazlakaTextSecondary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="اختر موسماً لعرض حلقاته" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource FazlakaTextPrimary}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
