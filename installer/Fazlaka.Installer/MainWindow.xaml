<Window x:Class="Fazlaka.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fazlaka Installer" Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0F19"
        Foreground="White">

    <Window.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,24,28,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#7C3AED">
                        <TextBlock Text="&#x645;" FontSize="22" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="&#x641;&#x630;&#x644;&#x643;&#x629;" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Windows Installer" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>
                <Border Height="1" Background="#1F2937"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="28,8,28,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Version -->
            <TextBlock Grid.Row="0" Text="Version 1.1.4" FontSize="12" Foreground="#6B7280" Margin="0,0,0,16"/>

            <!-- Install Path -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="Install Location" FontSize="13" FontWeight="SemiBold"
                           Foreground="#D1D5DB" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#111827" BorderBrush="#374151"
                            BorderThickness="1" CornerRadius="6" Padding="10,7">
                        <TextBlock x:Name="InstallPathText" Text="C:\Users\alysa\AppData\Local\Fazlaka"
                                   FontSize="13" Foreground="#D1D5DB" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BrowseButton}"
                            Margin="6,0,0,0" Click="OnBrowseClick"/>
                </Grid>
            </StackPanel>

            <!-- Status -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock x:Name="StatusText" Text="Ready to install"
                           FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                <Border x:Name="ProgressBorder" Background="#1F2937" CornerRadius="4" Height="6">
                    <Border x:Name="ProgressBar" Background="#7C3AED" CornerRadius="4"
                            Width="0" HorizontalAlignment="Left"/>
                </Border>
            </StackPanel>

            <!-- Details -->
            <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="Fazlaka will be installed to the selected location with desktop and Start Menu shortcuts."
                               FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Padding="28,12,28,20">
            <Grid>
                <Border Height="1" Background="#1F2937" VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="OnUninstallClick" Visibility="Collapsed"/>
                    <Button x:Name="CancelButton" Content="Close" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="OnCancelClick"/>
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButton}"
                            Click="OnInstallClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
