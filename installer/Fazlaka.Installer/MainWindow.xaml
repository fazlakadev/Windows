<Window x:Class="Fazlaka.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fazlaka Installer" Width="680" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0F19"
        Foreground="White">

    <Window.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="32,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="32,20,32,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#7C3AED">
                        <TextBlock Text="&#x645;" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="&#x641;&#x630;&#x644;&#x643;&#x629;" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Windows Installer v1.1.6" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step Indicator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="Step1Dot" Width="10" Height="10" Fill="#7C3AED" Margin="0,0,4,0"/>
                    <TextBlock x:Name="Step1Label" Text="Welcome" FontSize="11" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Ellipse x:Name="Step2Dot" Width="10" Height="10" Fill="#374151" Margin="0,0,4,0"/>
                    <TextBlock x:Name="Step2Label" Text="Location" FontSize="11" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Ellipse x:Name="Step3Dot" Width="10" Height="10" Fill="#374151" Margin="0,0,4,0"/>
                    <TextBlock x:Name="Step3Label" Text="Install" FontSize="11" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Ellipse x:Name="Step4Dot" Width="10" Height="10" Fill="#374151" Margin="0,0,4,0"/>
                    <TextBlock x:Name="Step4Label" Text="Done" FontSize="11" Foreground="#374151" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#1F2937"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="32,8,32,8">
            <!-- Step 1: Welcome -->
            <Grid x:Name="WelcomePanel" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="100" Height="100" CornerRadius="24" Background="#1E1B4B" Margin="0,0,0,24"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#x645;" FontSize="56" FontWeight="Bold"
                                   Foreground="#7C3AED" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,-4,0,0"/>
                    </Border>
                    <TextBlock Text="&#x622;&#x647;&#x644;&#x627;&#x64B; &#x628;&#x643;" FontSize="26" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="&#x641;&#x630;&#x644;&#x643;&#x629; &#x647;&#x64A; &#x627;&#x644;&#x645;&#x639;&#x644;&#x648;&#x654;&#x62A; &#x627;&#x644;&#x62A;&#x634;&#x63A;&#x64A;&#x644;&#x629; &#x644;&#x644;&#x62A;&#x639;&#x644;&#x64A;&#x645; &#x628;&#x639;&#x646; &#x643;&#x644; &#x627;&#x644;&#x645;&#x639;&#x644;&#x648;&#x645;&#x627;&#x62A; &#x627;&#x644;&#x62A;&#x634;&#x63A;&#x64A;&#x644;&#x629; &#x627;&#x644;&#x645;&#x648;&#x642;&#x639;&#x629;."
                               FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap"
                               MaxWidth="400" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="This will install Fazlaka v1.1.6 on your computer."
                               FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Step 2: Choose Location -->
            <Grid x:Name="LocationPanel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Choose Install Location" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Select the folder where you want to install Fazlaka."
                               FontSize="13" Foreground="#6B7280" Margin="0,0,0,24"/>

                    <TextBlock Text="Install Location" FontSize="13" FontWeight="SemiBold"
                               Foreground="#D1D5DB" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#111827" BorderBrush="#374151"
                                BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <TextBlock x:Name="InstallPathText" Text=""
                                       FontSize="13" Foreground="#D1D5DB" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BrowseButton}"
                                Margin="8,0,0,0" Click="OnBrowseClick"/>
                    </Grid>

                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1"
                            CornerRadius="10" Padding="16,12" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="Fazlaka will be installed to the selected location. Desktop and Start Menu shortcuts will be created automatically."
                                       FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Step 3: Installing -->
            <Grid x:Name="InstallingPanel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Installing Fazlaka" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StatusText" Text="Preparing installation..."
                               FontSize="13" Foreground="#9CA3AF" Margin="0,0,0,20"/>

                    <Border Background="#1F2937" CornerRadius="6" Height="8" Margin="0,0,0,12">
                        <Border x:Name="ProgressBar" Background="#7C3AED" CornerRadius="6"
                                Width="0" HorizontalAlignment="Left"/>
                    </Border>

                    <TextBlock x:Name="DetailText" Text=""
                               FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Step 4: Complete -->
            <Grid x:Name="CompletePanel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="90" Height="90" CornerRadius="22" Background="#064E3B"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="&#x2713;" FontSize="48" FontWeight="Bold"
                                   Foreground="#10B981" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <TextBlock Text="Installation Complete!" FontSize="24" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="Fazlaka has been successfully installed on your computer."
                               FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="InstallPathFinal" Text=""
                               FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="32,12,32,24">
            <Grid>
                <Border Height="1" Background="#1F2937" VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="BackButton" Content="&#x2190; Back" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="OnBackClick" Visibility="Collapsed"/>
                    <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="OnUninstallClick" Visibility="Collapsed"/>
                    <Button x:Name="CloseButton" Content="Close" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="OnCloseClick"/>
                    <Button x:Name="NextButton" Content="Next &#x2192;" Style="{StaticResource AccentButton}"
                            Click="OnNextClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
