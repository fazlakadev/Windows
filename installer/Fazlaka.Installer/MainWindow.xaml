<Window x:Class="Fazlaka.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fazlaka Installer" Width="520" Height="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F1017" Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Purple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="PurpleDark" Color="#6D28D9"/>
        <SolidColorBrush x:Key="Gold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="Green" Color="#10B981"/>
        <SolidColorBrush x:Key="Red" Color="#EF4444"/>
        <SolidColorBrush x:Key="BgCard" Color="#1A1D2E"/>
        <SolidColorBrush x:Key="Dim" Color="#6B7280"/>
        <SolidColorBrush x:Key="Border" Color="#2A2D3E"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1D2E" BorderBrush="#2A2D3E" BorderThickness="0,0,0,1" Padding="24,18">
            <StackPanel>
                <TextBlock Text="&#x1F4E6;" FontSize="28" Margin="0,0,0,8"/>
                <TextBlock Text="Fazlaka Installer" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="&#x0641;&#x0630;&#x0644;&#x0629; — Windows Desktop App" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Install path -->
            <Border Grid.Row="0" Background="#1A1D2E" CornerRadius="10" Padding="14,12" BorderBrush="#2A2D3E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Installation Location" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <TextBlock x:Name="InstallPathText" FontSize="12" Foreground="#E5E7EB" FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100"
                             Background="#1E2235" Foreground="#8B5CF6" BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                <Border x:Name="PART_Track" CornerRadius="4">
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4"
                                            HorizontalAlignment="Left"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="StatusText" Text="Ready to install" FontSize="12" Foreground="#9CA3AF" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Version -->
            <TextBlock Grid.Row="2" x:Name="VersionText" Text="Version 1.1.2" FontSize="11" Foreground="#6B7280" Margin="0,10,0,0"/>

            <!-- Error -->
            <TextBlock Grid.Row="3" x:Name="ErrorText" Text="" FontSize="12" Foreground="#EF4444"
                       TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="Collapsed"/>
        </Grid>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Background="#1A1D2E" BorderBrush="#2A2D3E" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UninstallBtn" Content="Uninstall" Width="90" Height="34"
                        Background="#1E2235" Foreground="#9CA3AF" BorderBrush="#2A2D3E" BorderThickness="1"
                        Cursor="Hand" Margin="0,0,10,0" Click="OnUninstallClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="12,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2A2D3E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="ActionBtn" Content="Install" Width="120" Height="34"
                        Background="#8B5CF6" Foreground="White" BorderThickness="0"
                        Cursor="Hand" FontWeight="SemiBold" Click="OnActionClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                    BorderThickness="0" Padding="12,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#7C3AED"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
