<Window x:Class="Fazlaka.Uninstall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fazlaka Uninstall" Width="480" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0F19"
        Foreground="White">

    <Window.Resources>
        <LinearGradientBrush x:Key="PurpleGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#7C3AED" />
            <GradientStop Offset="1" Color="#4C1D95" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DangerGrad" Color="#DC2626" />
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="32,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content -->
        <Grid Grid.Row="0" Margin="36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Confirm Panel -->
            <Grid x:Name="ConfirmPanel" Grid.Row="0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="90" Height="90" CornerRadius="22" Background="#2D1B1B"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                   Foreground="#EF4444" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="&#x625;&#x632;&#x627;&#x644;&#x629; Fazlaka" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="24" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="&#x627;&#x644;&#x62A;&#x637;&#x628;&#x64A;&#x642; &#x633;&#x64A;&#x62D;&#x630;&#x641; &#x62C;&#x645;&#x64A;&#x639; &#x627;&#x644;&#x645;&#x644;&#x627;&#x641;&#x638;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x631;&#x62A;&#x628;&#x637;&#x629; &#x628;&#x627;&#x644;&#x62A;&#x637;&#x628;&#x64A;&#x642; &#x648;&#x627;&#x644;&#x625;&#x639;&#x62F;&#x627;&#x62F;&#x627;&#x62A;."
                               FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap"
                               MaxWidth="340" HorizontalAlignment="Center" TextAlignment="Center"
                               LineHeight="22" Margin="0,0,0,6"/>
                    <TextBlock FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"
                               TextAlignment="Center">
                        <Run Text="&#x627;&#x644;&#x645;&#x633;&#x627;&#x631;:" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                        <Run x:Name="InstallPathText" Text="C:\Users\...\Fazlaka"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Progress Panel -->
            <Grid x:Name="ProgressPanel" Grid.Row="0" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar x:Name="UninstallRing" Width="120" Height="4" IsIndeterminate="True"
                                  HorizontalAlignment="Center" Margin="0,0,0,20"
                                  Foreground="#7C3AED" Background="#1F2937"/>
                    <TextBlock x:Name="StatusText" Text="&#x62C;&#x627;&#x631;&#x64D; &#x625;&#x632;&#x627;&#x644;&#x629; Fazlaka..."
                               FontSize="18" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="DetailText" Text=""
                               FontSize="12" Foreground="#6B7280"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Done Panel -->
            <Grid x:Name="DonePanel" Grid.Row="0" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="90" Height="90" CornerRadius="22" Background="#064E3B"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="&#x2713;" FontSize="48" FontWeight="Bold"
                                   Foreground="#10B981" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <TextBlock Text="&#x62A;&#x645; &#x625;&#x632;&#x627;&#x644;&#x629; Fazlaka &#x628;&#x646;&#x62C;&#x627;&#x62D;" FontSize="24" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="&#x62A;&#x645; &#x62D;&#x630;&#x641; &#x62C;&#x645;&#x64A;&#x639; &#x627;&#x644;&#x645;&#x644;&#x627;&#x641;&#x638;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x631;&#x62A;&#x628;&#x637;&#x629; &#x648;&#x627;&#x644;&#x625;&#x639;&#x62F;&#x627;&#x62F;&#x627;&#x62A; &#x628;&#x646;&#x62C;&#x627;&#x62D;."
                               FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Progress Bar -->
            <Border x:Name="ProgressBorder" Grid.Row="2" Background="#1F2937" CornerRadius="6" Height="6"
                    VerticalAlignment="Bottom" Visibility="Collapsed">
                <Border x:Name="ProgressBar" Background="#7C3AED" CornerRadius="6"
                        Width="0" HorizontalAlignment="Left"/>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1" Padding="36,12,36,24">
            <Grid>
                <Border Height="1" Background="#1F2937" VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CloseButton" Content="&#x625;&#x63A;&#x644;&#x627;&#x642;" Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0" Click="OnCloseClick"/>
                    <Button x:Name="UninstallButton" Content="&#x625;&#x632;&#x627;&#x644;&#x629; Fazlaka" Style="{StaticResource DangerButton}"
                            Click="OnUninstallClick"/>
                    <Button x:Name="FinishButton" Content="&#x625;&#x63A;&#x644;&#x627;&#x642;" Style="{StaticResource GhostButton}"
                            Click="OnCloseClick" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
